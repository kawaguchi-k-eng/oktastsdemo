# ============================================================
# Okta 側の設定
# ============================================================
# あなたのOkta組織のドメイン (例: dev-12345.okta.com)
OKTA_DOMAIN=your-tenant.okta.com

# 手動登録したAI AgentのClient ID
OKTA_AGENT_CLIENT_ID=

# AI Agent登録時にOktaが発行した秘密鍵 (PEM形式)。
# Amplify ではファイルを置けないため、PEM の中身を環境変数で渡す。
# 改行を含められない場合は次のどちらかで指定する:
#   (a) 改行を \n に置き換えた1行の文字列
#       例: -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
#   (b) PEM ファイル全体を Base64 化した文字列を OKTA_AGENT_PRIVATE_KEY_B64 に設定
#       PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("keys\agent_private_key.pem"))
OKTA_AGENT_PRIVATE_KEY=
OKTA_AGENT_PRIVATE_KEY_B64=

# ローカル開発時のみ: PEM ファイルのパスでも指定可能 (上の2つが空の場合に使われる)
OKTA_AGENT_PRIVATE_KEY_PATH=./keys/agent_private_key.pem

# AI Agent登録時に発行された鍵のkid (JWKのkid)
OKTA_AGENT_KEY_ID=

# Resource Connection(Applicationタイプ/Office 365)で設定した Resource Indicator
OKTA_OFFICE365_RESOURCE_INDICATOR=

# ============================================================
# Web版 (User access構成) 用の設定
# ============================================================
# セッションCookie暗号化用のSecret (32文字以上のランダム文字列)
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ユーザーがOktaにログインするためのOIDCアプリ (Authorization Code + PKCE)。
# AI Agent クライアントと同一アプリなら OKTA_AGENT_CLIENT_ID と同じ値を入れる。
OKTA_WEB_LOGIN_CLIENT_ID=

# ログイン用アプリのクライアント認証が「Client secret」の場合のみ設定する。
# 空なら AI Agent と同じ秘密鍵で private_key_jwt 認証する。
OKTA_WEB_LOGIN_CLIENT_SECRET=

# ログイン時に使う認可サーバーのIssuer URL
# Org Authorization Serverの場合: https://{yourOktaDomain}
# カスタム認可サーバーの場合    : https://{yourOktaDomain}/oauth2/{authServerId}
OKTA_ISSUER=https://your-tenant.okta.com

# アプリの公開URL (末尾スラッシュなし)。リダイレクトURIの組み立てに使う。
# 空の場合はリクエストのHost/X-Forwarded-*ヘッダーから推定する。
#   ローカル : http://localhost:5000
#   Amplify  : https://main.xxxxxxxx.amplifyapp.com
APP_BASE_URL=http://localhost:5000

# 上記URL + /authorization-code/callback をOktaアプリの Sign-in redirect URI に、
# 上記URL (+ /) を Sign-out redirect URI に登録しておく

# 「今日」「今週」などを判定する基準タイムゾーン (IANA形式)。
# Amplify (Lambda) の実行環境は UTC なので必ず指定する。
APP_TIMEZONE=Asia/Tokyo

# Microsoft Graph API の応答に使うタイムゾーン (Windows形式)
MS_GRAPH_TIMEZONE=Tokyo Standard Time

# ============================================================
# OpenAI 側の設定
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
